  "descriptions": {
    "de": {
      "language": "de",
      "value": "Historische Straße auf dem Balkan durch Albanien, Nord-Mazedonien, Griechenland, Bulgarien und die Türkei"
    },
    "hu": {
      "language": "hu",
      "value": "római kori út a Balkánon"
    },
    "mk": {
      "language": "mk",
      "value": "римски пат на Балканот"
    },
    "en": {
      "language": "en",
      "value": "Historic Roman road in the Balkans passing through Albania, North Macedonia, Greece, Bulgaria,Turkey"
    },
    "el": {
      "language": "el",
      "value": "Ιστορική ρωμαϊκή οδός στα Βαλκάνια που διασχίζει Αλβανία, Βόρεια Μακεδονία, Ελλάδα, Βουλγαρία, Τουρκία"
    },
    "he": {
      "language": "he",
      "value": "דרך רומית שהובילה מדירכיום (Dyrrachium), היא דורס בת ימינו שבאלבניה, אל ביזנטיון (כיום איסטנבול בטורקיה)"
    },
    "pl": {
      "language": "pl",
      "value": "historyczna droga rzymska przecinająca Półwysep Bałkański"
    },
    "eo": {
      "language": "eo",
      "value": "historia romia vojo en la balkano"
    },
    "it": {
      "language": "it",
      "value": "antica strada romana"
    },
    "tr": {
      "language": "tr",
      "value": "Roma Cumhuriyeti tarafından inşa edilen tarihî yol"
    },
    "cs": {
      "language": "cs",
      "value": "starověká římská silnice vybudovaná ve 2. století př. n. l. Procházela římskými provinciemi Illyria, Macedonia a Thracia na území dnešních států Albánie, Severní Makedonie, Řecka a evropské části Turecka"
    },
    "fr": {
      "language": "fr",
      "value": "voie romaine traversant les Balkans d'ouest en est"
    }
  },
