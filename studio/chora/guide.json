 "cycles": [
  {
   "id": "life-of-the-virgin",
   "title": {
    "en": "The Life of the Virgin",
    "tr": "Meryem’in Hayatı"
   },
   "intro": {
    "en": "Nineteen scenes in the inner narthex, in Ousterhout’s order: from Joachim and Anne longing for a child to Joseph coming home to find Mary with child. The cycle begins at the north end and turns back along the west wall.",
    "tr": "İç narteksteki on dokuz sahne, Ousterhout’un sırasıyla: Yuakim ile Anna’nın çocuk özleminden, Yusuf’un eve dönüp Meryem’i hamile bulmasına kadar. Döngü kuzey uçta başlar ve batı duvarı boyunca geri döner."
   },
   "artworks": [
    "M17",
