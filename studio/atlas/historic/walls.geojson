  {
   "type": "Feature",
   "properties": {
    "id": "blachernae-walls",
    "layer": "walls",
    "kind": "land-wall",
    "names": {
     "en": "Wall of Manuel Komnenos",
     "tr": "Manuel Komnenos Suru"
    },
    "from": 1180,
    "to": null,
    "certainty": "traced",
    "sources": [
     "wp-walls-of-constantinople-1383343183",
     "wikidata-historic-2026-11-10",
     "osm-walls-2026-11-10"
    ],
    "note": {
     "en": "Built by Manuel I Komnenos (r. 1143–1180) to protect the Palace of Blachernae; shown here from the end of his reign. Drawn through its gates to the Golden Horn. Before it, the northern end of the land walls lay on another line that is not drawn.",
     "tr": "I. Manuel Komnenos (h. 1143–1180) Blahernai Sarayı’nı korumak için yaptırdı; burada saltanatının sonundan itibaren gösterilir. Kapıları üzerinden Haliç’e kadar çizildi. Ondan önce kara surlarının kuzey ucu, çizilmeyen başka bir hattaydı."
    }
   },
