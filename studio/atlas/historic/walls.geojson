  {
   "type": "Feature",
   "properties": {
    "id": "galata-walls",
    "layer": "walls",
    "kind": "land-wall",
    "names": {
     "en": "Walls of Galata",
     "tr": "Galata Surları"
    },
    "from": 1349,
    "to": 1864,
    "certainty": "conjectural",
    "sources": [
     "trwp-galata-surlari-36016150",
     "wp-galata-tower-1384690717",
     "osm-walls-2026-11-10"
    ],
    "note": {
     "en": "The Genoese colony’s walls, extended north in 1349, 1387, 1397 and 1404, mostly demolished in 1864. Schematic: from the shore at Azapkapı through the surviving fragments and the Galata Tower down towards Karaköy; the shore ends are placed by hand.",
     "tr": "Ceneviz kolonisinin surları; 1349, 1387, 1397 ve 1404’te kuzeye uzatıldı, çoğu 1864’te yıkıldı. Şematik: Azapkapı kıyısından ayakta kalan parçalar ve Galata Kulesi üzerinden Karaköy’e doğru; kıyıdaki uçlar elle yerleştirildi."
    }
   },
